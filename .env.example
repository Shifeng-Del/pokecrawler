# 复制为 backend/.env 后按需修改

# 服务
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false

# 数据库（SQLite）
# DATABASE_URL=sqlite+aiosqlite:///D:/12/2026-10-14-22-21-12/backend/data/poke.db

# 数据源
POKEAPI_BASE=https://pokeapi.co
USER_AGENT=PokeCrawler/1.0 (+https://example.com/contact; python-httpx)

# 抓取器切换：httpx | playwright
CRAWLER_FETCHER=httpx
# 适配器切换：pokeapi | generic_html
CRAWLER_ADAPTER=pokeapi
# 解析器切换：json | css
CRAWLER_PARSER=json

# 礼貌爬取
CRAWLER_CONCURRENCY=6
CRAWLER_RATE_PER_SEC=5.0
CRAWLER_MIN_INTERVAL_MS=150
CRAWLER_RETRIES=5
CRAWLER_PAGE_SIZE=100
RESPECT_ROBOTS=true
ROBOTS_ON_ERROR=allow

# 存储开关
STORE_RAW_JSON=false
STORE_MOVES=true

# 定时任务
SCHEDULER_ENABLED=true
SCHEDULER_INCREMENTAL_HOUR=3
SCHEDULER_FULL_DAY_OF_WEEK=sun
SCHEDULER_FULL_HOUR=4
